{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "existing_content_inventory",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "site_id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "enum": [
            "wordpress_rest_export",
            "wordpress_rest_public",
            "wordpress_wxr",
            "user_confirmation"
          ]
        },
        "source_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "coverage_complete": {
          "type": "boolean"
        },
        "statuses_requested": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "statuses_observed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "imported_count": {
          "type": "integer",
          "minimum": 0
        },
        "imported_at": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "site_id",
        "source_type",
        "source_ref",
        "completeness",
        "coverage_complete",
        "statuses_requested",
        "statuses_observed",
        "expected_count",
        "imported_count",
        "imported_at",
        "limitations"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "content_id": {
            "type": "string",
            "pattern": "^wp-[a-f0-9]{16}-[1-9][0-9]*$"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "slug": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "publish_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "modified_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "post_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "genre": {
            "type": [
              "string",
              "null"
            ]
          },
          "subgenre": {
            "type": [
              "string",
              "null"
            ]
          },
          "topic_cluster": {
            "type": [
              "string",
              "null"
            ]
          },
          "access_type": {
            "enum": [
              "FREE",
              "PREMIUM",
              null
            ]
          },
          "primary_keyword": {
            "type": [
              "string",
              "null"
            ]
          },
          "secondary_keywords": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "search_intent": {
            "type": [
              "string",
              "null"
            ]
          },
          "explicit_need": {
            "type": [
              "string",
              "null"
            ]
          },
          "latent_need": {
            "type": [
              "string",
              "null"
            ]
          },
          "article_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_depth": {
            "type": [
              "string",
              "null"
            ]
          },
          "cta_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "cta_destination": {
            "type": [
              "string",
              "null"
            ]
          },
          "seo_policy_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "wordpress_post_id": {
            "type": "integer",
            "minimum": 1
          },
          "date_basis": {
            "enum": [
              "utc",
              "site_timezone_unknown"
            ]
          },
          "category": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "slug": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "name",
                "slug"
              ]
            }
          },
          "tags": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "slug": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "name",
                "slug"
              ]
            }
          },
          "internal_links": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "featured_image": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "wordpress_media_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "url": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "alt_text": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "wordpress_media_id",
                  "url",
                  "alt_text"
                ]
              }
            ]
          },
          "word_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "word_count_method": {
            "enum": [
              "cjk_character_plus_latin_number_token_v1",
              null
            ]
          },
          "body_available": {
            "type": "boolean"
          },
          "field_provenance": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "content_id",
          "title",
          "slug",
          "url",
          "status",
          "publish_date",
          "modified_date",
          "post_type",
          "genre",
          "subgenre",
          "topic_cluster",
          "access_type",
          "primary_keyword",
          "secondary_keywords",
          "search_intent",
          "explicit_need",
          "latent_need",
          "article_type",
          "content_depth",
          "cta_type",
          "cta_destination",
          "seo_policy_version",
          "wordpress_post_id",
          "date_basis",
          "category",
          "tags",
          "internal_links",
          "featured_image",
          "word_count",
          "word_count_method",
          "body_available",
          "field_provenance"
        ]
      }
    },
    "duplicates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "content_id": {
            "type": "string"
          },
          "conflict": {
            "type": "boolean"
          }
        },
        "required": [
          "content_id",
          "conflict"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "scope",
    "items",
    "duplicates"
  ]
}
