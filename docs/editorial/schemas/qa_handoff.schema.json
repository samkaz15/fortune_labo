{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blocked QA handoff contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "content_id": {
      "type": "string",
      "minLength": 1
    },
    "seo_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "brief_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "draft_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "stages": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent",
          "status"
        ],
        "properties": {
          "agent": {
            "enum": [
              "A29",
              "A32",
              "A28"
            ]
          },
          "status": {
            "const": "contract_pending"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "human_approval": {
      "type": "null"
    },
    "wordpress_handoff_allowed": {
      "const": false
    },
    "publication_allowed": {
      "const": false
    }
  },
  "required": [
    "content_id",
    "seo_policy_version",
    "brief_sha256",
    "draft_sha256",
    "schema_version",
    "artifact_ids",
    "stages",
    "findings",
    "blockers",
    "human_approval",
    "wordpress_handoff_allowed",
    "publication_allowed"
  ]
}
