{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samkaz15/fortune_labo/docs/editorial/schemas/a07_a08_brief.schema.json",
  "title": "A07 to A08 Editorial Brief",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "content_id": {
      "type": "string",
      "pattern": "^FL-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "mode": {
      "enum": [
        "offline_test",
        "a06_handoff"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "genre": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "keyword": {
      "type": "string",
      "minLength": 1
    },
    "secondary_keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "search_intent": {
      "enum": [
        "informational",
        "navigational",
        "commercial",
        "transactional",
        "local"
      ]
    },
    "explicit_need": {
      "type": "string",
      "minLength": 1
    },
    "latent_need": {
      "type": "string",
      "minLength": 1
    },
    "persona": {
      "type": "string",
      "minLength": 1
    },
    "reader_stage": {
      "enum": [
        "discovery",
        "understanding",
        "consideration",
        "action",
        "continuation",
        null
      ]
    },
    "access_type": {
      "enum": [
        "FREE",
        "PREMIUM"
      ]
    },
    "access_rationale": {
      "type": "string",
      "minLength": 1
    },
    "core_answer": {
      "type": "string",
      "minLength": 1
    },
    "content_depth": {
      "enum": [
        "short",
        "standard",
        "deep"
      ]
    },
    "article_type": {
      "enum": [
        "shrine_visit_report",
        "annual_outlook",
        "forecast_review",
        "method_explainer",
        "situation_guide",
        "practitioner_profile",
        "service_page",
        "hub_page"
      ]
    },
    "h2_h3_intent": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading_level": {
            "enum": [
              "h2",
              "h3"
            ]
          },
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "source_requirement": {
            "enum": [
              "visit_notes",
              "practitioner_judgment",
              "research",
              "ai_structurable"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "heading_level",
          "heading",
          "purpose",
          "source_requirement",
          "evidence_refs"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "source_requirement": {
                  "enum": [
                    "visit_notes",
                    "practitioner_judgment"
                  ]
                }
              },
              "required": [
                "source_requirement"
              ]
            },
            "then": {
              "properties": {
                "evidence_refs": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 2
    },
    "evidence_needed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "claim_kind": {
            "enum": [
              "FACT",
              "FORTUNE_INTERPRETATION",
              "TRADITION",
              "PERSONAL_EXPERIENCE",
              "PERSONAL_OPINION",
              "HYPOTHESIS"
            ]
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "status": {
            "enum": [
              "available",
              "pending",
              "not_applicable"
            ]
          }
        },
        "required": [
          "requirement",
          "claim_kind",
          "source_ref",
          "status"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "available"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "source_ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "personal_experience_needed": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "source_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "status": {
          "enum": [
            "not_required",
            "pending",
            "verified"
          ]
        },
        "handling": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "required",
        "source_ref",
        "status",
        "handling"
      ],
      "additionalProperties": false
    },
    "internal_link_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/internal_link"
      },
      "minItems": 1
    },
    "cta": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "booking",
            "list_signup",
            "related_content",
            "free_fortune",
            "member_registration",
            "premium",
            "none"
          ]
        },
        "destination": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "pattern": "^https?://"
        },
        "placement": {
          "type": "string",
          "minLength": 1
        },
        "copy_direction": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "candidate",
            "verified",
            "none"
          ]
        }
      },
      "required": [
        "type",
        "destination",
        "placement",
        "copy_direction",
        "status"
      ],
      "additionalProperties": false
    },
    "seo_policy_version": {
      "type": "string",
      "pattern": "^seo-policy-[0-9]+\\.[0-9]+\\.[0-9]+(?:-draft)?$"
    },
    "a06_source": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "not_issued",
            "received_not_validated",
            "validated"
          ]
        },
        "brief_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "opportunity_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "brief_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^BRIEF-[0-9]{4}$"
        },
        "opportunity_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^SEO-[0-9]{4}$"
        },
        "tier": {
          "enum": [
            "A",
            "B",
            "C",
            null
          ]
        },
        "content_path": {
          "enum": [
            "path_1_firsthand",
            "path_2_standard",
            null
          ]
        },
        "visit_record_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "binding_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "status",
        "brief_ref",
        "opportunity_ref",
        "brief_id",
        "opportunity_id",
        "tier",
        "content_path",
        "visit_record_id",
        "binding_gaps"
      ],
      "additionalProperties": false
    },
    "strategy_assessment": {
      "type": "object",
      "properties": {
        "moat_alignment": {
          "enum": [
            "required",
            "neutral",
            "conflicting",
            "unresolved"
          ]
        },
        "strategy_review_status": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "not_required"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "moat_alignment",
        "strategy_review_status",
        "rationale"
      ],
      "additionalProperties": false
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "source_status": {
      "enum": [
        "structured_from_user_research",
        "a06_validated_with_editorial_extensions"
      ]
    },
    "handoff": {
      "type": "object",
      "properties": {
        "from": {
          "const": "A07"
        },
        "to": {
          "const": "A08"
        },
        "state": {
          "enum": [
            "offline_test_only",
            "ready",
            "blocked"
          ]
        },
        "next_stages": {
          "const": [
            "A29",
            "A32",
            "A28",
            "human_approval",
            "A25_wordpress_draft"
          ]
        }
      },
      "required": [
        "from",
        "to",
        "state",
        "next_stages"
      ],
      "additionalProperties": false
    },
    "human_approval": {
      "const": null
    },
    "publication_allowed": {
      "const": false
    },
    "tbd": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "content_id",
    "mode",
    "title",
    "genre",
    "topic",
    "keyword",
    "secondary_keywords",
    "search_intent",
    "explicit_need",
    "latent_need",
    "persona",
    "reader_stage",
    "access_type",
    "access_rationale",
    "core_answer",
    "content_depth",
    "article_type",
    "h2_h3_intent",
    "evidence_needed",
    "personal_experience_needed",
    "internal_link_candidates",
    "cta",
    "seo_policy_version",
    "a06_source",
    "strategy_assessment",
    "source_refs",
    "source_status",
    "handoff",
    "human_approval",
    "publication_allowed",
    "tbd"
  ],
  "additionalProperties": false,
  "$defs": {
    "internal_link": {
      "type": "object",
      "properties": {
        "target_content_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "target_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "pattern": "^https?://"
        },
        "anchor_text": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "outbound_from_this_page",
            "inbound_to_this_page"
          ]
        },
        "status": {
          "enum": [
            "candidate",
            "verified"
          ]
        }
      },
      "required": [
        "target_content_id",
        "target_url",
        "anchor_text",
        "rationale",
        "direction",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "target_url": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "offline_test"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "a06_source": {
            "properties": {
              "status": {
                "const": "not_issued"
              },
              "brief_ref": {
                "type": "null"
              },
              "opportunity_ref": {
                "type": "null"
              },
              "brief_id": {
                "type": "null"
              },
              "opportunity_id": {
                "type": "null"
              },
              "tier": {
                "type": "null"
              },
              "content_path": {
                "type": "null"
              },
              "visit_record_id": {
                "type": "null"
              }
            }
          },
          "handoff": {
            "properties": {
              "state": {
                "const": "offline_test_only"
              }
            }
          },
          "source_status": {
            "const": "structured_from_user_research"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "a06_handoff"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "a06_source": {
            "properties": {
              "status": {
                "const": "validated"
              },
              "brief_ref": {
                "type": "string"
              },
              "opportunity_ref": {
                "type": "string"
              },
              "brief_id": {
                "type": "string"
              },
              "opportunity_id": {
                "type": "string"
              },
              "tier": {
                "type": "string"
              },
              "content_path": {
                "type": "string"
              }
            }
          },
          "source_status": {
            "const": "a06_validated_with_editorial_extensions"
          },
          "handoff": {
            "properties": {
              "state": {
                "enum": [
                  "ready",
                  "blocked"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "a06_source": {
            "properties": {
              "content_path": {
                "const": "path_1_firsthand"
              }
            }
          }
        },
        "required": [
          "a06_source"
        ]
      },
      "then": {
        "properties": {
          "a06_source": {
            "properties": {
              "visit_record_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "personal_experience_needed": {
            "properties": {
              "required": {
                "const": true
              },
              "status": {
                "const": "verified"
              },
              "source_ref": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "strategy_assessment": {
            "properties": {
              "moat_alignment": {
                "const": "conflicting"
              }
            }
          }
        },
        "required": [
          "strategy_assessment"
        ]
      },
      "then": {
        "properties": {
          "handoff": {
            "properties": {
              "state": {
                "enum": [
                  "offline_test_only",
                  "blocked"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
