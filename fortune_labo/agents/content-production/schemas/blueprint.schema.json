{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A08 Article Blueprint",
  "type": "object",
  "properties": {
    "content_id": {
      "type": "string",
      "pattern": "^FL-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "seo_policy_version": {
      "type": "string",
      "pattern": "^seo-policy-[0-9]+\\.[0-9]+\\.[0-9]+(?:-draft)?$"
    },
    "core_answer": {
      "type": "string",
      "minLength": 1
    },
    "access_type": {
      "enum": [
        "FREE",
        "PREMIUM"
      ]
    },
    "access_rationale": {
      "type": "string",
      "minLength": 1
    },
    "evidence_needed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "claim_kind": {
            "enum": [
              "FACT",
              "FORTUNE_INTERPRETATION",
              "TRADITION",
              "PERSONAL_EXPERIENCE",
              "PERSONAL_OPINION",
              "HYPOTHESIS"
            ]
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "status": {
            "enum": [
              "available",
              "pending",
              "not_applicable"
            ]
          }
        },
        "required": [
          "requirement",
          "claim_kind",
          "source_ref",
          "status"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "available"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "source_ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "personal_experience_needed": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "source_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "status": {
          "enum": [
            "not_required",
            "pending",
            "verified"
          ]
        },
        "handling": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "required",
        "source_ref",
        "status",
        "handling"
      ],
      "additionalProperties": false
    },
    "internal_link_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/internal_link"
      },
      "minItems": 0
    },
    "cta": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "booking",
            "list_signup",
            "related_content",
            "free_fortune",
            "member_registration",
            "premium",
            "none"
          ]
        },
        "destination": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "pattern": "^https?://"
        },
        "placement": {
          "type": "string",
          "minLength": 1
        },
        "copy_direction": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "candidate",
            "verified",
            "none"
          ]
        }
      },
      "required": [
        "type",
        "destination",
        "placement",
        "copy_direction",
        "status"
      ],
      "additionalProperties": false
    },
    "publication_allowed": {
      "const": false
    },
    "human_approval": {
      "const": null
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "brief_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading_level": {
            "enum": [
              "h2",
              "h3"
            ]
          },
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "source_requirement": {
            "enum": [
              "visit_notes",
              "practitioner_judgment",
              "research",
              "ai_structurable"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "heading_level",
          "heading",
          "purpose",
          "source_requirement",
          "evidence_refs"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "source_requirement": {
                  "enum": [
                    "visit_notes",
                    "practitioner_judgment"
                  ]
                }
              },
              "required": [
                "source_requirement"
              ]
            },
            "then": {
              "properties": {
                "evidence_refs": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 2
    },
    "writing_rules_reference": {
      "const": "docs/editorial/ARTICLE_PRODUCTION_RULES.md"
    },
    "writing_rules_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "content_id",
    "seo_policy_version",
    "core_answer",
    "access_type",
    "access_rationale",
    "evidence_needed",
    "personal_experience_needed",
    "internal_link_candidates",
    "cta",
    "publication_allowed",
    "human_approval",
    "schema_version",
    "brief_sha256",
    "sections",
    "writing_rules_reference",
    "writing_rules_sha256"
  ],
  "additionalProperties": false,
  "$defs": {
    "internal_link": {
      "type": "object",
      "properties": {
        "target_content_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "target_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "pattern": "^https?://"
        },
        "anchor_text": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "outbound_from_this_page",
            "inbound_to_this_page"
          ]
        },
        "status": {
          "enum": [
            "candidate",
            "verified"
          ]
        }
      },
      "required": [
        "target_content_id",
        "target_url",
        "anchor_text",
        "rationale",
        "direction",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "target_url": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  }
}
