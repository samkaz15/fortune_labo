{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/samkaz15/fortune_labo/agents/content-strategy/schemas/editorial_calendar.schema.json",
  "title": "Editorial Calendar",
  "description": "Rolling 90-day publication plan maintained by Content Strategy Agent. Committed capacity must never exceed the practitioner's stated capacity; if it does, the calendar is published as an escalation to A01 Strategy Agent with a cut list, not as a plan.",
  "type": "object",
  "required": ["id", "period_start", "period_end", "capacity", "slots", "capacity_status", "generated_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^CAL-[0-9]{4}-[0-9]{2}$" },
    "period_start": { "type": "string", "format": "date" },
    "period_end": { "type": "string", "format": "date" },

    "capacity": {
      "type": "object",
      "required": ["visits_per_month", "judgment_sessions_per_month", "review_hours_per_month", "source"],
      "properties": {
        "visits_per_month": { "type": "integer", "minimum": 0 },
        "judgment_sessions_per_month": { "type": "integer", "minimum": 0 },
        "review_hours_per_month": { "type": "number", "minimum": 0 },
        "source": {
          "type": "string",
          "enum": ["practitioner_stated", "assumed"],
          "description": "'assumed' must be flagged in the report. Planning against assumed capacity is a known risk."
        },
        "stated_at": { "type": ["string", "null"], "format": "date" }
      },
      "additionalProperties": false
    },

    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["brief_id", "content_type", "publish_by", "source_material_status", "slot_status"],
        "properties": {
          "brief_id": { "type": "string", "pattern": "^CB-[0-9]{4}$" },
          "content_type": {
            "type": "string",
            "enum": [
              "shrine_visit_report", "annual_outlook", "forecast_review", "method_explainer",
              "situation_guide", "practitioner_profile", "service_page", "hub_page",
              "faq_page", "case_reflection"
            ]
          },
          "topic_cluster": { "type": ["string", "null"] },
          "seasonal_window": {
            "type": ["string", "null"],
            "enum": ["hatsumode", "setsubun_risshun", "shichigosan", "oharae_june", "oharae_december", "annual_outlook", null]
          },
          "visit_by": { "type": ["string", "null"], "format": "date" },
          "brief_issued_by": { "type": ["string", "null"], "format": "date" },
          "draft_by": { "type": ["string", "null"], "format": "date" },
          "qa_by": { "type": ["string", "null"], "format": "date" },
          "approval_by": { "type": ["string", "null"], "format": "date" },
          "publish_by": { "type": "string", "format": "date" },
          "source_material_status": {
            "type": "string",
            "enum": ["available", "requested", "blocked", "not_required"],
            "description": "A slot whose material is 'blocked' is parked, never written around."
          },
          "capacity_cost": {
            "type": "object",
            "properties": {
              "visits": { "type": "integer", "minimum": 0 },
              "judgment_sessions": { "type": "integer", "minimum": 0 },
              "review_load": { "type": "string", "enum": ["low", "medium", "high"] }
            },
            "additionalProperties": false
          },
          "slot_status": {
            "type": "string",
            "enum": ["planned", "in_production", "at_risk", "parked", "complete", "missed"]
          },
          "risk_note": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },

    "committed_capacity": {
      "type": "object",
      "properties": {
        "visits": { "type": "integer", "minimum": 0 },
        "judgment_sessions": { "type": "integer", "minimum": 0 },
        "review_load_index": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "capacity_status": {
      "type": "string",
      "enum": ["within_capacity", "at_capacity", "over_capacity"],
      "description": "over_capacity requires cut_list and escalation to A01 Strategy Agent. The calendar is then an escalation, not a plan."
    },
    "cut_list": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["brief_id", "reason"],
        "properties": {
          "brief_id": { "type": "string", "pattern": "^CB-[0-9]{4}$" },
          "reason": { "type": "string" },
          "expected_impact_forgone": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      },
      "default": [],
      "description": "Ordered by lowest expected booking impact first."
    },

    "portfolio_check": {
      "type": "object",
      "properties": {
        "firsthand_brief_ratio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "firsthand_ratio_direction": { "type": ["string", "null"], "enum": ["rising", "flat", "falling", null] },
        "rewrite_share": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "orphan_slots": { "type": "integer", "minimum": 0, "default": 0 },
        "spokes_without_live_hub": { "type": "integer", "minimum": 0, "default": 0 },
        "escalations": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "A falling firsthand_brief_ratio is a P0 escalation to A01 regardless of traffic."
        }
      },
      "additionalProperties": false
    },

    "generated_at": { "type": "string", "format": "date" }
  },
  "allOf": [
    {
      "if": { "properties": { "capacity_status": { "const": "over_capacity" } }, "required": ["capacity_status"] },
      "then": { "required": ["cut_list"], "properties": { "cut_list": { "type": "array", "minItems": 1 } } }
    }
  ],
  "additionalProperties": false
}
